# ==============================================================================
# Veytrix Tech Studio — Environment Configuration Template
# Copy this file to .env.local for local development.
# In production / preview, configure these directly in your Vercel Project Settings.
# ==============================================================================

# Lead Engine / Contact API (Resend.com)
# In production, set RESEND_API_KEY from your Resend dashboard.
# CONTACT_TO_EMAIL: Destination inbox for project inquiries (e.g. intake@veytrix.tech)
# CONTACT_FROM_EMAIL: Verified sender address (e.g. Veytrix Tech <intake@veytrix.tech> or onboarding@resend.dev during onboarding)
RESEND_API_KEY=
CONTACT_TO_EMAIL=intake@veytrix.tech
CONTACT_FROM_EMAIL=Veytrix Tech <intake@veytrix.tech>

# Canonical Production Site URL
NEXT_PUBLIC_SITE_URL=https://veytrix.tech
