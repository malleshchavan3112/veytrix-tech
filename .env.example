# ==============================================================================
# Veytrix Tech Studio — Environment Configuration Template
# Copy this file to .env.local for local development.
# In production / preview, configure these directly in your Vercel Project Settings.
# ==============================================================================

# Lead Engine / Contact API (Resend.com)
# When RESEND_API_KEY is not defined, incoming validated submissions are safely logged to console in development.
RESEND_API_KEY=re_your_api_key_here
CONTACT_EMAIL=intake@veytrix.tech

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://veytrix.tech
